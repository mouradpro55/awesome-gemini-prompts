Screen {
    background: $background;
}

#ping_controls, #socket_controls, #serial_controls, #sniffer_controls {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

Input {
    width: 30;
    margin-right: 1;
}

Select {
    width: 20;
    margin-right: 1;
}

Button {
    margin-right: 1;
}

Log {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

TabPane {
    padding: 1;
}
